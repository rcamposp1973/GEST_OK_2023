# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for CORS validation, self-referential links, and OAuth callbacks.
APP_URL="MY_APP_URL"

# SII_API_KEY: Clave de suscripción oficial para integración SII / SimpleAPI.cl.
# Si no se proporciona en la solicitud, el servidor utilizará este valor.
SII_API_KEY="YOUR_SII_API_KEY_HERE"

# SECRETS_ENCRYPTION_KEY: Clave maestra de 32 bytes para cifrado AES-256-GCM de certificados y claves SII.
SECRETS_ENCRYPTION_KEY="pegar_aqui_64_caracteres_hexadecimales"

# ALLOWED_SII_HOSTS: Lista blanca de dominios permitidos para llamadas SII (SSRF Defense).
ALLOWED_SII_HOSTS="simpleapi.cl,api.simpleapi.cl,servicios.simpleapi.cl,zeus.sii.cl,mpt.sii.cl"

# FIREBASE_PROJECT_ID: ID del proyecto Firebase para inicialización en el servidor.
FIREBASE_PROJECT_ID="gen-lang-client-0478013396"
