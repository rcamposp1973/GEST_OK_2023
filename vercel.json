{
  "version": 2,
  "rewrites": [
    { "source": "/api/health", "destination": "/api/index" },
    { "source": "/api/indicators/sync", "destination": "/api/index" },
    { "source": "/api/companies/:companyId/secrets", "destination": "/api/index" },
    { "source": "/api/auth/set-user-claims", "destination": "/api/index" },
    { "source": "/api/auth/create-user", "destination": "/api/index" },
    { "source": "/api/sii/test-connection", "destination": "/api/index" },
    { "source": "/api/notebook-ai", "destination": "/api/index" },
    { "source": "/api/agents/conciliador", "destination": "/api/index" },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
